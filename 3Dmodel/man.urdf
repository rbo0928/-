<?xml version="1.0" ?>
<robot name="man">

  <!-- 行人 -->
  <link name="man">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 1.57079632679"/>
      <geometry>
        <mesh filename="man.dae" scale="0.5 0.5 0.5"/>
      </geometry>
       <material name="man">
        <color rgba="0.5 0.5 0.5 1"/> <!-- 灰色 -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 1.57079632679"/>
      <geometry>
        <mesh filename="man.dae" scale="0.5 0.5 0.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

</robot>
